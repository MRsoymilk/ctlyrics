#!/bin/sh
set -eu

show_tools_help() {
    cat <<'EOF'
Usage: ctlyrics.AppImage tools <command> [arguments]

Commands:
  get-songs   Generate a song list from a music directory
  get-lyrics  Search and download LRC lyrics
  auto-map    Match music files with downloaded LRC files

Run "ctlyrics.AppImage tools <command> --help" for command options.
EOF
}

if [ "${1:-}" = "tools" ]; then
    shift
    command_name="${1:-}"
    case "$command_name" in
        ""|-h|--help)
            show_tools_help
            exit 0
            ;;
        get-songs|get_songs_from_directory|get_songs_from_directory.py)
            script=get_songs_from_directory.py
            ;;
        get-lyrics|get_lyrics|get_lyrics.py)
            script=get_lyrics.py
            ;;
        auto-map|auto_map|auto_map.py)
            script=auto_map.py
            ;;
        *)
            printf 'Unknown tool: %s\n\n' "$command_name" >&2
            show_tools_help >&2
            exit 2
            ;;
    esac
    shift
    exec python3 "$APPDIR/usr/lib/ctlyrics/tools/$script" "$@"
fi

exec "$APPDIR/usr/bin/ctlyrics" "$@"
